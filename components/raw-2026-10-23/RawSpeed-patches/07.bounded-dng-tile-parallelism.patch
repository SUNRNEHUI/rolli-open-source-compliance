+TEST(DngLJpegTileIntegrationTest, EdgeTilesAreIdenticalForOneToFourWorkers) {
+  constexpr int imageWidth = 5;
+  constexpr int imageHeight = 5;
+  constexpr int tileWidth = Width;
+  constexpr int tileHeight = Height;
+
+  for (unsigned workers : {1U, 2U, 3U, 4U}) {
+    auto image = rawspeed::RawImage::create(
+        {imageWidth, imageHeight}, rawspeed::TYPE_USHORT16, Components);
+    rawspeed::DngTilingDescription tiling(image->dim, tileWidth, tileHeight);
+    rawspeed::AbstractDngDecompressor decompressor(
+        image, tiling, 7, false, Precision, ~0U, workers);
+    std::vector<std::vector<uint8_t>> fixtures;
+    fixtures.reserve(tiling.numTiles);
+    for (unsigned tile = 0; tile < tiling.numTiles; ++tile)
+      fixtures.emplace_back(makeFixture(7, Expected));
+    for (unsigned tile = 0; tile < tiling.numTiles; ++tile) {
+      const rawspeed::Buffer buffer(fixtures[tile].data(), fixtures[tile].size());
+      decompressor.slices.emplace_back(
+          decompressor.dsc, tile,
+          rawspeed::ByteStream(rawspeed::DataBuffer(
+              buffer, rawspeed::Endianness::big)));
+    }
+
+    const auto metrics = decompressor.decompress();
+    EXPECT_EQ(metrics.jobsCompleted, tiling.numTiles);
+    EXPECT_GE(metrics.workersUsed, 1U);
+    EXPECT_LE(metrics.workersUsed, workers);
+    const auto pixels = image->getU16DataAsUncroppedArray2DRef();
+    for (int row = 0; row < imageHeight; ++row)
+      for (int col = 0; col < imageWidth; ++col)
+        for (int component = 0; component < Components; ++component) {
+          const int localRow = row % tileHeight;
+          const int localCol = col % tileWidth;
+          EXPECT_EQ(pixels(row, col * Components + component),
+                    Expected[(localRow * tileWidth + localCol) * Components +
+                             component]);
+        }
+  }
+}
+
+TEST(DngLJpegTileIntegrationTest, CorruptTileRejectsWholeDecode) {
+  auto image = rawspeed::RawImage::create({5, 5}, rawspeed::TYPE_USHORT16,
+                                          Components);
+  rawspeed::DngTilingDescription tiling(image->dim, Width, Height);
+  rawspeed::AbstractDngDecompressor decompressor(
+      image, tiling, 7, false, Precision, ~0U, 4);
+  std::vector<std::vector<uint8_t>> fixtures;
+  fixtures.reserve(tiling.numTiles);
+  for (unsigned tile = 0; tile < tiling.numTiles; ++tile)
+    fixtures.emplace_back(makeFixture(7, Expected));
+  fixtures[1][0] = 0;
+  for (unsigned tile = 0; tile < tiling.numTiles; ++tile) {
+    const rawspeed::Buffer buffer(fixtures[tile].data(), fixtures[tile].size());
+    decompressor.slices.emplace_back(
+        decompressor.dsc, tile,
+        rawspeed::ByteStream(rawspeed::DataBuffer(
+            buffer, rawspeed::Endianness::big)));
+  }
+
+  bool published = false;
+  try {
+    const auto metrics = decompressor.decompress();
+    published = metrics.jobsCompleted == tiling.numTiles;
+    FAIL() << "corrupt tile did not reject DNG decode";
+  } catch (const rawspeed::RawDecoderException&) {
+  }
+  EXPECT_FALSE(published);
+}
