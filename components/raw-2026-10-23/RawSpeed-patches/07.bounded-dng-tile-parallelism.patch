new file mode 100644
index 00000000..e5e95421
--- /dev/null
+++ b/test/librawspeed/decompressors/DngTileSchedulerTest.cpp
@@ -0,0 +1,96 @@
+#include "decompressors/DngTileScheduler.h"
+#include <gtest/gtest.h>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <unordered_set>
+#include <vector>
+
+namespace rawspeed_test {
+using namespace rawspeed;
+
+TEST(DngTileSchedulerTest, WorkerOneUsesCallerOnly) {
+  std::thread::id caller = std::this_thread::get_id();
+  std::vector<std::thread::id> threads(8);
+  const auto metrics = runDngTileJobs(threads.size(), 1, [&](size_t tile) {
+    threads[tile] = std::this_thread::get_id();
+  });
+
+  EXPECT_EQ(metrics.jobsCompleted, threads.size());
+  EXPECT_EQ(metrics.workersUsed, 1U);
+  for (const auto id : threads)
+    EXPECT_EQ(id, caller);
+}
+
+TEST(DngTileSchedulerTest, BoundedWorkersActuallyParticipate) {
+  for (unsigned requested : {2U, 3U, 4U}) {
+    std::mutex mutex;
+    std::unordered_set<std::thread::id> threads;
+    std::atomic<unsigned> arrived{0};
+    const auto metrics = runDngTileJobs(48, requested, [&](size_t) {
+      {
+        std::lock_guard<std::mutex> lock(mutex);
+        threads.insert(std::this_thread::get_id());
+      }
+      arrived.fetch_add(1, std::memory_order_relaxed);
+      while (arrived.load(std::memory_order_relaxed) < requested)
+        std::this_thread::yield();
+    });
+
+    EXPECT_EQ(metrics.jobsCompleted, 48U);
+    EXPECT_EQ(metrics.workersUsed, requested);
+    EXPECT_EQ(threads.size(), requested);
+  }
+}
+
+TEST(DngTileSchedulerTest, OutputIsDeterministicForEdgeAndWeirdWidthTiles) {
+  constexpr size_t tileCount = 11;
+  constexpr size_t weirdWidth = 503;
+  std::vector<uint64_t> reference(tileCount);
+  for (size_t i = 0; i < tileCount; ++i)
+    reference[i] = (i + 1) * weirdWidth * UINT64_C(0x9e3779b97f4a7c15);
+
+  for (unsigned repeat = 0; repeat < 20; ++repeat) {
+    for (unsigned workers : {1U, 2U, 3U, 4U}) {
+      std::vector<uint64_t> output(tileCount);
+      const auto metrics = runDngTileJobs(tileCount, workers, [&](size_t i) {
+        output[i] = (i + 1) * weirdWidth * UINT64_C(0x9e3779b97f4a7c15);
+      });
+      EXPECT_EQ(metrics.jobsCompleted, tileCount);
+      EXPECT_EQ(output, reference);
+    }
+  }
+}
+
+TEST(DngTileSchedulerTest, FirstFailureIsRethrownAfterJoinAndResultRejected) {
+  std::atomic<unsigned> active{0};
+  std::atomic<unsigned> completed{0};
+  bool published = false;
+
+  try {
+    const auto metrics = runDngTileJobs(48, 4, [&](size_t tile) {
+      active.fetch_add(1, std::memory_order_relaxed);
+      if (tile == 0) {
+        active.fetch_sub(1, std::memory_order_relaxed);
+        throw std::runtime_error("first tile failure");
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      completed.fetch_add(1, std::memory_order_relaxed);
+      active.fetch_sub(1, std::memory_order_relaxed);
+    });
+    published = metrics.jobsCompleted == 48;
+    FAIL() << "scheduler did not rethrow tile failure";
+  } catch (const std::runtime_error& error) {
+    EXPECT_STREQ(error.what(), "first tile failure");
+  }
+
+  EXPECT_EQ(active.load(), 0U);
+  EXPECT_FALSE(published);
+  EXPECT_LT(completed.load(), 48U);
+}
+
+} // namespace rawspeed_test
