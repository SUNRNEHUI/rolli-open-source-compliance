diff --git a/src/librawspeed/decompressors/DngTileScheduler.h b/src/librawspeed/decompressors/DngTileScheduler.h
new file mode 100644
index 00000000..4cd3d1f2
--- /dev/null
+++ b/src/librawspeed/decompressors/DngTileScheduler.h
@@ -0,0 +1,107 @@
+/*
+    RawSpeed - RAW file decoder.
+
+    This library is free software; you can redistribute it and/or modify it
+    under the terms of the GNU Lesser General Public License.
+*/
+
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <exception>
+#include <mutex>
+#include <thread>
+#include <utility>
+#include <vector>
+
+namespace rawspeed {
+
+struct DngTileSchedulerMetrics final {
+  unsigned workersUsed = 0;
+  size_t jobsCompleted = 0;
+};
+
+template <typename Job>
+DngTileSchedulerMetrics runDngTileJobs(size_t jobCount,
+                                       unsigned requestedWorkers, Job&& job) {
+  if (jobCount == 0)
+    return {};
+
+  const unsigned workerCount = std::min<unsigned>(
+      4, std::min<size_t>(std::max(1U, requestedWorkers), jobCount));
+  if (workerCount == 1) {
+    for (size_t index = 0; index < jobCount; ++index)
+      job(index);
+    return {1, jobCount};
+  }
+
+  std::atomic<size_t> nextJob{0};
+  std::atomic<size_t> jobsCompleted{0};
+  std::atomic<unsigned> workersUsedMask{0};
+  std::atomic<unsigned> workersReady{0};
+  std::atomic<bool> start{false};
+  std::atomic<bool> cancelled{false};
+  std::mutex failureMutex;
+  size_t firstFailedJob = jobCount;
+  std::exception_ptr firstFailure;
+
+  auto worker = [&](unsigned workerIndex, bool waitForStart) noexcept {
+    if (waitForStart) {
+      workersReady.fetch_add(1, std::memory_order_release);
+      while (!start.load(std::memory_order_acquire))
+        std::this_thread::yield();
+    }
+
+    while (!cancelled.load(std::memory_order_acquire)) {
+      const size_t index = nextJob.fetch_add(1, std::memory_order_relaxed);
+      if (index >= jobCount)
+        break;
+      workersUsedMask.fetch_or(1U << workerIndex, std::memory_order_relaxed);
+      try {
+        job(index);
+        jobsCompleted.fetch_add(1, std::memory_order_relaxed);
+      } catch (...) {
+        {
+          std::lock_guard<std::mutex> lock(failureMutex);
+          if (index < firstFailedJob) {
+            firstFailedJob = index;
+            firstFailure = std::current_exception();
+          }
+        }
+        cancelled.store(true, std::memory_order_release);
+      }
+    }
+  };
+
+  std::vector<std::thread> threads;
+  threads.reserve(workerCount - 1);
+  try {
+    for (unsigned index = 1; index < workerCount; ++index)
+      threads.emplace_back(worker, index, true);
+  } catch (...) {
+    cancelled.store(true, std::memory_order_release);
+    start.store(true, std::memory_order_release);
+    for (auto& thread : threads)
+      thread.join();
+    throw;
+  }
+
+  workersReady.fetch_add(1, std::memory_order_release);
+  while (workersReady.load(std::memory_order_acquire) != workerCount)
+    std::this_thread::yield();
+  start.store(true, std::memory_order_release);
+  worker(0, false);
+  for (auto& thread : threads)
+    thread.join();
+
+  if (firstFailure)
+    std::rethrow_exception(firstFailure);
+
+  return {static_cast<unsigned>(
+              __builtin_popcount(workersUsedMask.load(std::memory_order_relaxed))),
+          jobsCompleted.load(std::memory_order_relaxed)};
+}
+
+} // namespace rawspeed
