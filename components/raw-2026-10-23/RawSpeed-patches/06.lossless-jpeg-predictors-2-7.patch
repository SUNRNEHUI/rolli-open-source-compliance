+#include "io/ByteStream.h"
+#include "io/Endianness.h"
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdlib>
+#include <gtest/gtest.h>
+#include <vector>
+
+extern "C" int rawspeed_get_number_of_processor_cores() { return 1; }
+
+namespace rawspeed_test {
+namespace {
+
+constexpr int Width = 3;
+constexpr int Height = 3;
+constexpr int Components = 3;
+constexpr int Precision = 12;
+using Samples = std::array<uint16_t, Width * Height * Components>;
+
+class BitWriter final {
+  std::vector<uint8_t> bytes;
+  uint8_t byte = 0;
+  unsigned used = 0;
+
+  void emitByte(uint8_t value) {
+    bytes.push_back(value);
+    if (value == 0xff)
+      bytes.push_back(0x00);
+  }
+
+public:
+  void put(unsigned value, unsigned count) {
+    for (unsigned bit = count; bit > 0; --bit) {
+      byte = static_cast<uint8_t>((byte << 1) | ((value >> (bit - 1)) & 1U));
+      if (++used == 8) {
+        emitByte(byte);
+        byte = 0;
+        used = 0;
+      }
+    }
+  }
+
+  std::vector<uint8_t> finish() {
+    if (used != 0) {
+      byte = static_cast<uint8_t>(byte << (8 - used));
+      emitByte(byte);
+    }
+    // BitPumpJPEG refills in machine-word chunks.
+    bytes.insert(bytes.end(), 8, 0);
+    return bytes;
+  }
+};
+
+void appendU16(std::vector<uint8_t>& bytes, unsigned value) {
+  bytes.push_back(static_cast<uint8_t>(value >> 8));
+  bytes.push_back(static_cast<uint8_t>(value));
+}
+
+void appendMarker(std::vector<uint8_t>& bytes, uint8_t marker,
+                  const std::vector<uint8_t>& payload) {
+  bytes.push_back(0xff);
+  bytes.push_back(marker);
+  appendU16(bytes, payload.size() + 2);
+  bytes.insert(bytes.end(), payload.begin(), payload.end());
+}
+
+int predictor(const Samples& samples, unsigned mode, int row, int col,
+              int component) {
+  if (row == 0 && col == 0)
+    return 1 << (Precision - 1);
+  const auto at = [&](int y, int x) {
+    return static_cast<int>(samples[(y * Width + x) * Components + component]);
+  };
+  if (row == 0)
+    return at(row, col - 1); // Ra
+  if (col == 0)
+    return at(row - 1, col); // Rb
+  const int ra = at(row, col - 1);
+  const int rb = at(row - 1, col);
+  const int rc = at(row - 1, col - 1);
+  const auto floorHalf = [](int value) {
+    return value >= 0 ? value / 2 : -((-value + 1) / 2);
+  };
+  switch (mode) {
+  case 1: return ra;
+  case 2: return rb;
+  case 3: return rc;
+  case 4: return ra + rb - rc;
+  case 5: return ra + floorHalf(rb - rc);
+  case 6: return rb + floorHalf(ra - rc);
+  case 7: return (ra + rb) / 2;
+  default: std::abort();
+  }
+}
+
+void encodeDifference(BitWriter& writer, int difference) {
+  const unsigned magnitude = static_cast<unsigned>(std::abs(difference));
+  unsigned category = 0;
+  for (unsigned n = magnitude; n != 0; n >>= 1)
+    ++category;
+  ASSERT_LE(category, 16U);
+
+  // The fixture DHT contains canonical five-bit codes 0..16.
+  writer.put(category, 5);
+  if (category == 0)
+    return;
+  const unsigned bits = difference > 0
+                            ? static_cast<unsigned>(difference)
+                            : static_cast<unsigned>(difference +
+                                                    ((1 << category) - 1));
+  writer.put(bits, category);
+}
+
+std::vector<uint8_t> makeFixture(unsigned mode, const Samples& samples) {
+  std::vector<uint8_t> bytes{0xff, 0xd8}; // SOI
+
+  std::vector<uint8_t> dht{0x00};
+  dht.insert(dht.end(), 4, 0);
+  dht.push_back(17); // 17 canonical codes of length five.
+  dht.insert(dht.end(), 11, 0);
+  for (unsigned category = 0; category <= 16; ++category)
+    dht.push_back(static_cast<uint8_t>(category));
+  appendMarker(bytes, 0xc4, dht);
+
+  std::vector<uint8_t> sof{Precision, 0, Height, 0, Width, Components};
+  for (unsigned component = 1; component <= Components; ++component) {
+    sof.push_back(static_cast<uint8_t>(component));
+    sof.push_back(0x11);
+    sof.push_back(0);
+  }
+  appendMarker(bytes, 0xc3, sof);
+
+  std::vector<uint8_t> sos{Components};
+  for (unsigned component = 1; component <= Components; ++component) {
+    sos.push_back(static_cast<uint8_t>(component));
+    sos.push_back(0x00);
+  }
+  sos.push_back(static_cast<uint8_t>(mode));
+  sos.push_back(0);
+  sos.push_back(0);
+  appendMarker(bytes, 0xda, sos);
+
+  BitWriter writer;
+  for (int row = 0; row < Height; ++row) {
+    for (int col = 0; col < Width; ++col) {
+      for (int component = 0; component < Components; ++component) {
+        const auto index = (row * Width + col) * Components + component;
+        encodeDifference(writer, static_cast<int>(samples[index]) -
+                                     predictor(samples, mode, row, col,
+                                               component));
+      }
+    }
+  }
+  auto scan = writer.finish();
+  bytes.insert(bytes.end(), scan.begin(), scan.end());
+  bytes.push_back(0xff);
+  bytes.push_back(0xd9); // EOI
+  return bytes;
+}
+
+Samples decode(const std::vector<uint8_t>& fixture) {
+  const rawspeed::Buffer buffer(fixture.data(), fixture.size());
+  const rawspeed::DataBuffer data(buffer, rawspeed::Endianness::big);
+  const rawspeed::ByteStream stream(data);
+  auto image = rawspeed::RawImage::create({Width, Height},
+                                          rawspeed::TYPE_USHORT16, Components);
+  rawspeed::LJpegDecompressor decoder(stream, image);
+  decoder.decode(0, 0, Width, Height, false);
+
+  Samples decoded{};
+  const auto pixels = image->getU16DataAsUncroppedArray2DRef();
+  for (int row = 0; row < Height; ++row)
+    for (int col = 0; col < Width * Components; ++col)
+      decoded[row * Width * Components + col] = pixels(row, col);
+  return decoded;
+}
+
+std::vector<uint8_t> makeLayoutFixture(unsigned mode, int precision, int pt,
+                                       int frameWidth, int height,
+                                       int frameComponents,
+                                       const std::vector<uint16_t>& samples) {
+  const auto sampleAt = [&](int row, int col, int component) {
+    return static_cast<int>(samples[(row * frameWidth + col) *
+                                    frameComponents + component]);
+  };
+  const auto predictAt = [&](int row, int col, int component) {
+    if (row == 0 && col == 0)
+      return 1 << (precision - pt - 1);
+    if (row == 0)
+      return sampleAt(row, col - 1, component);
+    if (col == 0)
+      return sampleAt(row - 1, col, component);
+    const int ra = sampleAt(row, col - 1, component);
+    const int rb = sampleAt(row - 1, col, component);
+    const int rc = sampleAt(row - 1, col - 1, component);
+    const auto floorHalf = [](int value) {
+      return value >= 0 ? value / 2 : -((-value + 1) / 2);
+    };
+    switch (mode) {
+    case 1: return ra;
+    case 2: return rb;
+    case 3: return rc;
+    case 4: return ra + rb - rc;
+    case 5: return ra + floorHalf(rb - rc);
+    case 6: return rb + floorHalf(ra - rc);
+    case 7: return (ra + rb) / 2;
+    default: std::abort();
+    }
+  };
+
+  std::vector<uint8_t> bytes{0xff, 0xd8};
+  std::vector<uint8_t> dht{0x00};
+  dht.insert(dht.end(), 4, 0);
+  dht.push_back(17);
+  dht.insert(dht.end(), 11, 0);
+  for (unsigned category = 0; category <= 16; ++category)
+    dht.push_back(static_cast<uint8_t>(category));
+  appendMarker(bytes, 0xc4, dht);
+
+  std::vector<uint8_t> sof{static_cast<uint8_t>(precision),
+                           static_cast<uint8_t>(height >> 8),
+                           static_cast<uint8_t>(height),
+                           static_cast<uint8_t>(frameWidth >> 8),
+                           static_cast<uint8_t>(frameWidth),
+                           static_cast<uint8_t>(frameComponents)};
+  for (int component = 1; component <= frameComponents; ++component) {
+    sof.push_back(static_cast<uint8_t>(component));
+    sof.push_back(0x11);
+    sof.push_back(0);
+  }
+  appendMarker(bytes, 0xc3, sof);
+
+  std::vector<uint8_t> sos{static_cast<uint8_t>(frameComponents)};
+  for (int component = 1; component <= frameComponents; ++component) {
+    sos.push_back(static_cast<uint8_t>(component));
+    sos.push_back(0);
+  }
+  sos.push_back(static_cast<uint8_t>(mode));
+  sos.push_back(0);
+  sos.push_back(static_cast<uint8_t>(pt));
+  appendMarker(bytes, 0xda, sos);
+
+  BitWriter writer;
+  for (int row = 0; row < height; ++row)
+    for (int col = 0; col < frameWidth; ++col)
+      for (int component = 0; component < frameComponents; ++component)
+        encodeDifference(writer, sampleAt(row, col, component) -
+                                     predictAt(row, col, component));
+  auto scan = writer.finish();
+  bytes.insert(bytes.end(), scan.begin(), scan.end());
+  bytes.push_back(0xff);
+  bytes.push_back(0xd9);
+  return bytes;
+}
+
+std::vector<uint16_t> decodeLayout(const std::vector<uint8_t>& fixture,
+                                   int width, int height, int cpp) {
+  const rawspeed::Buffer buffer(fixture.data(), fixture.size());
+  const rawspeed::DataBuffer data(buffer, rawspeed::Endianness::big);
+  const rawspeed::ByteStream stream(data);
+  auto image = rawspeed::RawImage::create({width, height},
+                                          rawspeed::TYPE_USHORT16, cpp);
+  rawspeed::LJpegDecompressor decoder(stream, image);
+  decoder.decode(0, 0, width, height, false);
+  const auto pixels = image->getU16DataAsUncroppedArray2DRef();
+  std::vector<uint16_t> decoded(width * height * cpp);
+  for (int row = 0; row < height; ++row)
+    for (int col = 0; col < width * cpp; ++col)
+      decoded[row * width * cpp + col] = pixels(row, col);
+  return decoded;
+}
+
+const Samples Expected{{
+    2048, 2047, 2049, 0,    4095, 1024, 1,    4094, 1023,
+    4095, 0,    3072, 2049, 2048, 2047, 1024, 1025, 4095,
+    4094, 1,    0,    2047, 3073, 2048, 2,    4093, 4095,
+}};
+
+class LJpegPredictorTest : public testing::TestWithParam<unsigned> {};
+
+TEST_P(LJpegPredictorTest, DecodesDeterministicThreeComponentScan) {
+  EXPECT_EQ(decode(makeFixture(GetParam(), Expected)), Expected);
+}
+
+INSTANTIATE_TEST_CASE_P(AllLosslessModes, LJpegPredictorTest,
+                        testing::Values(1, 2, 3, 4, 5, 6, 7));
+
+TEST(LJpegPredictorCorruptStreamTest, RejectsTruncatedEntropyData) {
+  auto fixture = makeFixture(7, Expected);
+  const std::array<uint8_t, 2> sosMarker{0xff, 0xda};
+  const auto sos = std::search(fixture.begin(), fixture.end(),
+                               sosMarker.begin(), sosMarker.end());
+  ASSERT_NE(sos, fixture.end());
+  const size_t sosOffset = sos - fixture.begin();
+  const size_t scanOffset = sosOffset + 2 +
+      (static_cast<size_t>(fixture[sosOffset + 2]) << 8) +
+      fixture[sosOffset + 3];
+  ASSERT_LT(scanOffset + 4, fixture.size());
+  fixture.resize(scanOffset + 4);
+  EXPECT_THROW(decode(fixture), rawspeed::RawspeedException);
+}
+
+TEST(LJpegPredictorLayoutTest, DecodesOneTwoAndFourComponentScans) {
+  for (const int cpp : {1, 2, 4}) {
+    SCOPED_TRACE(testing::Message() << "cpp=" << cpp);
+    std::vector<uint16_t> samples(4 * 2 * cpp);
+    for (size_t i = 0; i < samples.size(); ++i)
+      samples[i] = static_cast<uint16_t>(900 + 17 * i);
+    try {
+      EXPECT_EQ(decodeLayout(makeLayoutFixture(7, 12, 0, 4, 2, cpp, samples),
+                             4, 2, cpp), samples) << "cpp=" << cpp;
+    } catch (const rawspeed::RawspeedException& error) {
+      FAIL() << "cpp=" << cpp << " error=" << error.what();
+    }
+  }
+}
+
+TEST(LJpegPredictorLayoutTest, ProducesPartialBlockAndDiscardsRemainder) {
+  const std::vector<uint16_t> encoded{1000, 1001, 1002, 4095};
+  const std::vector<uint16_t> expected(encoded.begin(), encoded.begin() + 3);
+  EXPECT_EQ(decodeLayout(makeLayoutFixture(7, 12, 0, 2, 1, 2, encoded),
+                         3, 1, 1), expected);
+}
+
+TEST(LJpegPredictorPointTransformTest, DecodesReducedSampleRange) {
+  const std::vector<uint16_t> samples{0, 1023, 511, 512};
+  EXPECT_EQ(decodeLayout(makeLayoutFixture(7, 12, 2, 2, 2, 1, samples),
+                         2, 2, 1), samples);
+}
+
+TEST(LJpegPredictorPointTransformTest, RejectsInvalidPrecisionAndTransform) {
+  const std::vector<uint16_t> samples{1};
+  auto fixture = makeLayoutFixture(7, 2, 0, 1, 1, 1, samples);
+  const std::array<uint8_t, 2> sosMarker{0xff, 0xda};
+  const auto sos = std::search(fixture.begin(), fixture.end(),
+                               sosMarker.begin(), sosMarker.end());
+  ASSERT_NE(sos, fixture.end());
+  const size_t sosOffset = sos - fixture.begin();
+  const size_t sosLength = (static_cast<size_t>(fixture[sosOffset + 2]) << 8) |
+                           fixture[sosOffset + 3];
+  fixture[sosOffset + 2 + sosLength - 1] = 2;
+  EXPECT_THROW(decodeLayout(fixture, 1, 1, 1),
+               rawspeed::RawDecoderException);
+}
+
+TEST(LJpegPredictorRangeTest, RejectsReconstructedSampleAbovePrecision) {
+  const std::vector<uint16_t> samples{4096};
+  EXPECT_THROW(decodeLayout(makeLayoutFixture(7, 12, 0, 1, 1, 1, samples),
+                            1, 1, 1), rawspeed::RawDecoderException);
+}
+
+TEST(LJpegPredictorMarkerOrderTest, RejectsSosBeforeSof) {
+  auto fixture = makeFixture(7, Expected);
+  const std::array<uint8_t, 2> sofMarker{0xff, 0xc3};
+  const std::array<uint8_t, 2> sosMarker{0xff, 0xda};
+  const auto sof = std::search(fixture.begin(), fixture.end(),
+                               sofMarker.begin(), sofMarker.end());
+  const auto sos = std::search(fixture.begin(), fixture.end(),
+                               sosMarker.begin(), sosMarker.end());
+  ASSERT_NE(sof, fixture.end());
+  ASSERT_NE(sos, fixture.end());
+  std::iter_swap(sof + 1, sos + 1);
+  EXPECT_THROW(decode(fixture), rawspeed::RawDecoderException);
+}
+
+TEST(LJpegPredictorComponentOrderTest, RejectsReorderedSosSelectors) {
+  auto fixture = makeFixture(7, Expected);
+  const std::array<uint8_t, 2> sosMarker{0xff, 0xda};
+  const auto sos = std::search(fixture.begin(), fixture.end(),
+                               sosMarker.begin(), sosMarker.end());
+  ASSERT_NE(sos, fixture.end());
+  const size_t sosOffset = sos - fixture.begin();
+  ASSERT_EQ(fixture[sosOffset + 4], Components);
+  fixture[sosOffset + 5] = 3;
+  fixture[sosOffset + 7] = 2;
+  fixture[sosOffset + 9] = 1;
+  EXPECT_THROW(decode(fixture), rawspeed::RawDecoderException);
+}
