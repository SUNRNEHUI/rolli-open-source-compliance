+template <int N_COMP, bool WeirdWidth>
+void LJpegDecompressor::decodeNWithPredictor() {
+  assert(predictorMode >= 2 && predictorMode <= 7);
+  assert(N_COMP >= mRaw->getCpp());
+
+  const CroppedArray2DRef<uint16_t> img(mRaw->getU16DataAsUncroppedArray2DRef(),
+                                        mRaw->getCpp() * offX, offY,
+                                        mRaw->getCpp() * w, h);
+  auto ht = getHuffmanTables<N_COMP>();
+  const auto initial = getInitialPredictors<N_COMP>();
+  const int32_t maximum = 2 * static_cast<int32_t>(initial[0]) - 1;
+  BitPumpJPEG bitStream(input);
+
+  const auto decodeValue = [&](unsigned row, unsigned col, int component) {
+    int32_t prediction;
+    if (row == 0 && col == 0) {
+      prediction = initial[component];
+    } else if (row == 0) {
+      prediction = img(row, col - N_COMP + component);
+    } else if (col == 0) {
+      prediction = img(row - 1, component);
+    } else {
+      const int32_t ra = img(row, col - N_COMP + component);
+      const int32_t rb = img(row - 1, col + component);
+      const int32_t rc = img(row - 1, col - N_COMP + component);
+      prediction = predict(predictorMode, ra, rb, rc);
+    }
+
+    const int32_t value = prediction + ht[component]->decodeDifference(bitStream);
+    if (value < 0 || value > maximum)
+      ThrowRDE("LJPEG sample outside valid range: %i", value);
+    return static_cast<uint16_t>(value);
+  };
+
+  for (unsigned row = 0; row < h; ++row) {
+    unsigned col = 0;
+    for (; col < N_COMP * fullBlocks; col += N_COMP)
+      for (int component = 0; component < N_COMP; ++component)
+        img(row, col + component) = decodeValue(row, col, component);
+
+    if /*constexpr*/ (WeirdWidth) {
+      unsigned component = 0;
+      for (; component < trailingPixels; ++component)
+        img(row, col + component) = decodeValue(row, col, component);
+      for (; component < N_COMP; ++component)
+        ht[component]->decodeDifference(bitStream);
+      col += N_COMP;
+    }
+
+    for (; col < N_COMP * frame.w; col += N_COMP)
+      for (int component = 0; component < N_COMP; ++component)
+        ht[component]->decodeDifference(bitStream);
+  }
+}
+
 } // namespace rawspeed
